# Lazurite local environment template
# Copy to .env and fill values for local Fastlane lanes.

# -----------------------------------------------------------------------------
# Bluesky test account (used by screenshot automation)
# -----------------------------------------------------------------------------
BSKY_TEST_HANDLE=example.bsky.social
BSKY_TEST_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# -----------------------------------------------------------------------------
# App identifiers and Apple account metadata
# -----------------------------------------------------------------------------
IOS_APP_IDENTIFIER=org.stormlightlabs.lazurite
ANDROID_APP_IDENTIFIER=org.stormlightlabs.lazurite
APP_STORE_CONNECT_APPLE_ID=your-apple-id@example.com
APPLE_DEVELOPER_TEAM_ID=8TVR4TPL9Y
APP_STORE_CONNECT_TEAM_ID=YOUR_ITC_TEAM_ID

# -----------------------------------------------------------------------------
# TODO: App Store Connect API (distribution lanes)
# -----------------------------------------------------------------------------
ASC_KEY_ID=
ASC_ISSUER_ID=
# Multi-line .p8 contents; use quoted/newline-escaped format if needed.
ASC_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# TODO: Optional match-based signing (distribution lanes)
# -----------------------------------------------------------------------------
MATCH_GIT_URL=
MATCH_PASSWORD=

# -----------------------------------------------------------------------------
# TODO: Android signing (distribution lanes)
# -----------------------------------------------------------------------------
# Base64-encoded upload-keystore.jks
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# -----------------------------------------------------------------------------
# TODO: Google Play API (distribution lanes)
# -----------------------------------------------------------------------------
# Raw JSON or path strategy based on your workflow conventions.
PLAY_SERVICE_ACCOUNT_JSON=
