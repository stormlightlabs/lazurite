# ------------------------------------------------------------------------------
# Build metadata
# ------------------------------------------------------------------------------
FLUTTER_BUILD_NAME=1.0.0
FLUTTER_BUILD_NUMBER=1

# App identifiers
ANDROID_APPLICATION_ID=org.stormlightlabs.lazurite
IOS_BUNDLE_ID=org.stormlightlabs.lazurite

# ------------------------------------------------------------------------------
# Android signing (Play + side channels)
# ------------------------------------------------------------------------------
ANDROID_KEYSTORE_PATH=/absolute/path/upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=

# Optional: if using android/key.properties templating
ANDROID_KEY_PROPERTIES_PATH=android/key.properties

# ------------------------------------------------------------------------------
# Google Play
# ------------------------------------------------------------------------------
PLAY_PACKAGE_NAME=org.stormlightlabs.lazurite
PLAY_TRACK=internal
PLAY_CHANGES_NOT_SENT_FOR_REVIEW=true

# ------------------------------------------------------------------------------
# App Store Connect / TestFlight
# ------------------------------------------------------------------------------
ASC_APPLE_ID=
ASC_TEAM_ID=
ASC_BUNDLE_ID=org.stormlightlabs.lazurite
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_API_PRIVATE_KEY_PATH=/absolute/path/AuthKey_ABC123XYZ.p8

# ------------------------------------------------------------------------------
# AltStore PAL / Classic
# ------------------------------------------------------------------------------
ALTSTORE_DEVELOPER_ID=
ALTSTORE_CONTACT_EMAIL=
ALTSTORE_MARKETPLACE_TOKEN=
ALTSTORE_APPLE_MARKETPLACE_ID=
ALTSTORE_SOURCE_JSON_URL=https://example.com/altstore/source.json
ALTSTORE_ADP_HOST_ROOT=https://example.com/lazurite/adp/
ALTSTORE_CLASSIC_IPA_URL=https://example.com/lazurite/lazurite.ipa

# ------------------------------------------------------------------------------
# Firebase / FCM
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_ANDROID_PACKAGE_NAME=org.stormlightlabs.lazurite
FIREBASE_IOS_BUNDLE_ID=org.stormlightlabs.lazurite

# File locations in this repo
FIREBASE_ANDROID_CONFIG_PATH=android/app/google-services.json
FIREBASE_IOS_CONFIG_PATH=ios/Runner/GoogleService-Info.plist

# APNs auth for iOS push via Firebase Cloud Messaging
FIREBASE_APNS_KEY_ID=
FIREBASE_APNS_TEAM_ID=
FIREBASE_APNS_P8_PATH=/absolute/path/AuthKey_APNS.p8

# ------------------------------------------------------------------------------
# GitHub release automation
# ------------------------------------------------------------------------------
GITHUB_REPOSITORY=owner/repo
GITHUB_RELEASE_TAG=v${FLUTTER_BUILD_NAME}
GITHUB_RELEASE_NOTES_MODE=generate

# Optional: API token for release automation jobs
GITHUB_TOKEN=
