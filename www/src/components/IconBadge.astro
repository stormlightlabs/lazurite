---
interface Props {
  src: string;
  alt: string;
  tone?: "blue" | "violet";
  class?: string;
}

const { src, alt, tone = "blue", class: className = "" } = Astro.props;
---

<span class:list={["icon-badge", `icon-badge--${tone}`, className]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
</span>
